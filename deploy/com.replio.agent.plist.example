<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template launchd plist for a single Replio agent fleet member on macOS.
     Copy to ~/Library/LaunchAgents/com.replio.<name>.plist, replace <NAME>
     and the project path, then load it:
       launchctl load ~/Library/LaunchAgents/com.replio.<NAME>.plist
     KeepAlive keeps the agent running. The API key comes from the agent's own
     ~/.config/replio/config.json or .replio/config.json. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.replio.&lt;NAME&gt;</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/replio</string>
        <string>serve</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8787</string>
        <string>--path</string>
        <string>/Users/&lt;USER&gt;/agents/&lt;NAME&gt;</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/replio-&lt;NAME&gt;.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/replio-&lt;NAME&gt;.err.log</string>
</dict>
</plist>
