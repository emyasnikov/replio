# Template systemd unit for a single Replio agent fleet member.
# Copy to /etc/systemd/system/replio@.service. Enable one instance per agent:
#   systemctl enable replio@docs --now
# The %i instance name resolves to the agent's project directory, so each
# agent reads its own .replio/config.json and writes its own sessions.
# Set the API key per instance via an EnvironmentFile at /etc/replio/<name>.env
#   REPLIO_API_KEY=...
[Unit]
Description=Replio agent %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/srv/replio/%i
ExecStart=/usr/local/bin/replio serve --host 127.0.0.1 --port 8787 --path /srv/replio/%i
EnvironmentFile=-/etc/replio/%i.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
