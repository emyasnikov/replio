# Example: a fleet of single-purpose Replio agents under Docker Compose.
# Copy to docker-compose.yml and adjust per agent: REPLIO_PATH, ports, and
# environment. The API key and the non-root container user come from a .env
# file next to this one:
#   REPLIO_API_KEY=...
#   UID=1000   # must match the owner of the mounted agent folders (pi is 1000)
#   GID=1000
# Ports are published on 127.0.0.1 so the JSON API stays host-local.
services:
  docs-agent:
    build:
      context: .
    user: "${UID:-1000}:${GID:-1000}"
    environment:
      REPLIO_PORT: 8781
      REPLIO_PATH: /srv/docs
    volumes:
      - ./agents/docs:/srv/docs
    ports:
      - "127.0.0.1:8781:8781"
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M

  code-agent:
    build:
      context: .
    user: "${UID:-1000}:${GID:-1000}"
    environment:
      REPLIO_PORT: 8782
      REPLIO_PATH: /srv/src
    volumes:
      - ./agents/src:/srv/src
    ports:
      - "127.0.0.1:8782:8782"
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M
